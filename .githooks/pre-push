#!/bin/sh
# Keep main green: typecheck + every package's tests must pass before anything is pushed.
# Emergency escape: SKIP_CHECKS=1 git push
if [ "$SKIP_CHECKS" = "1" ]; then
  echo "pre-push: checks skipped (SKIP_CHECKS=1)"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-push: npm run check…"
if ! npm run check --silent; then
  echo "pre-push: push blocked, typecheck/tests are failing."
  exit 1
fi
