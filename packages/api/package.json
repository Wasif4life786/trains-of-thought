{
  "name": "@tot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A3 Controller: HTTP API that wires the lanes together (contract.md §5.3)",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --include \"../engine/src/**\" --include \"../rail/src/**\" --include \"../signals/src/**\" --include \"../shared/src/**\" --exclude \"../**/*.test.ts\" src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tot/engine": "*",
    "@tot/rail": "*",
    "@tot/shared": "*",
    "@tot/signals": "*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
