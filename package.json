{
  "name": "trains-of-thought",
  "private": true,
  "type": "module",
  "description": "When should I take the train? Messy world data in, cheap and reliable departure out.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @tot/api",
    "dev:web": "npm run dev -w @tot/web",
    "build": "npm run build -w @tot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "fixtures": "npm run fixtures -w @tot/shared",
    "hive:join": "node scripts/hive/join.mjs",
    "hive:status": "node scripts/hive/status.mjs",
    "hive:sync": "node scripts/hive/sync.mjs",
    "hive:ask": "node scripts/hive/ask.mjs",
    "prepare": "node scripts/hive/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
