# Copy to .env (git-ignored). Everything here is optional: without keys the app runs on
# no-key sources (Open-Meteo, gov.uk, openfootball, TheSportsDB test key) plus seed data.

API_PORT=8787

# 1 = never touch the network (tests force this). Flip on for the demo if the Wi-Fi is flaky.
TOT_OFFLINE=0

# A1 Signaller (optional sources)
THESPORTSDB_API_KEY=123
FOOTBALL_DATA_API_KEY=
TICKETMASTER_API_KEY=

# A2 Timetabler (optional sources)
RTT_USERNAME=
RTT_PASSWORD=
